{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and the slide-show window on a second display. File access goes only through the app's own commands, which are confined to the lesson library and app data; no fs, shell or http plugins.",
  "windows": [
    "main",
    "audience-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized"
  ]
}
